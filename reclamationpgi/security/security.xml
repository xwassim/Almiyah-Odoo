<odoo>
    <!-- Sous-Groupe : Responsable Technique -->
    <record id="group_responsable_tech" model="res.groups">
        <field name="name">Responsable Technique</field>
    </record>

    <!-- Sous-Groupe : Agents -->
    <record id="group_agents" model="res.groups">
        <field name="name">Agents</field>
    </record>
    

    <!-- Groupe Parent : Manager -->
    <record id="group_manager_1" model="res.groups">
        <field name="name">Reclamation / Manager</field>
        <!-- Ajouter les sous-groupes ici -->
        <field name="implied_ids" eval="[(4, ref('reclamationpgi.group_responsable_tech')), (4, ref('reclamationpgi.group_agents'))]"/>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Définition du rapport -->
    <record id="report_reclamationpgi" model="ir.actions.report">
        <field name="name">Rapport des Reclamations</field>
        <field name="model">reclamationpgi.reclamation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">reclamationpgi.report_reclamation</field>
        <field name="binding_model_id" ref="reclamationpgi.model_reclamationpgi_reclamation"/>
        <field name="binding_type">report</field>
    </record>
    <report
        id="report_reclamationpgi"
        model="reclamationpgi.reclamation"
        string="Liste des reclamations"
        report_type="qweb-pdf"
        file="reclamationpgi.report_reclamation"
        name="reclamationpgi.report_reclamation"
    />
    <!-- Template du rapport -->
    <template id="report_reclamation">
    <t t-call="web.html_container">
        <!-- Titre du rapport -->
        <h1 style="text-align: center; color: #0056b3;">Rapport des Reclamations </h1>
        <p style="text-align: center;">Genere le : <t t-esc="time.strftime('%d/%m/%Y')"/></p>

        <!-- Boucle pour afficher toutes les réclamations en continu -->
        <t t-foreach="docs" t-as="doc">
            <!-- Titre de chaque réclamation -->
            <h3 style="color: #0056b3; margin-top: 20px;">
                Reference : <t t-esc="doc.name"/>
            </h3>

            <!-- Tableau des détails de la réclamation -->
            <table style="width: 100%; margin-bottom: 20px;">
                <tr>
                    <td style="width: 30%;"><strong>Date de Reclamation :</strong></td>
                    <td><t t-esc="doc.date or 'Non specifiee'"/></td>
                </tr>
                <tr>
                    <td><strong>Objet :</strong></td>
                    <td><t t-esc="doc.objet or 'Non specifie'"/></td>
                </tr>
                <tr>
                    <td><strong>Description :</strong></td>
                    <td><t t-esc="doc.description or 'Non specifiee'"/></td>
                </tr>
                <tr>
                    <td><strong>Agence :</strong></td>
                    <td><t t-esc="doc.agency_id.name or 'Non specifie'"/></td>
                </tr>
                <tr>
                    <td><strong>Origine :</strong></td>
                    <td><t t-esc="dict(doc._fields['origin'].selection).get(doc.origin, 'Non specifiee')"/></td>
                </tr>
                <tr>
                    <td><strong>Provenance :</strong></td>
                    <td><t t-esc="dict(doc._fields['provenance'].selection).get(doc.provenance, 'Non specifie')"/></td>
                </tr>
                <tr>
                    <td><strong>Statut :</strong></td>
                    <td><t t-esc="dict(doc._fields['status'].selection).get(doc.status, 'Non specifie')"/></td>
                </tr>
            </table>

            <!-- Informations du Réclamant -->
            <h4 style="color: #0056b3;">Informations du Reclamant</h4>
            <t t-if="doc.reclamant_id">
                <table style="width: 100%;">
                    <tr>
                        <td style="width: 30%;"><strong>Type :</strong></td>
                        <td><t t-esc="doc.reclamant_id.type or 'Non specifie'"/></td>
                    </tr>
                    <t t-if="doc.reclamant_id.type == 'individual'">
                        <tr>
                            <td><strong>Prenom :</strong></td>
                            <td><t t-esc="doc.reclamant_id.reclamant_fname or 'Non specifie'"/></td>
                        </tr>
                        <tr>
                            <td><strong>Nom :</strong></td>
                            <td><t t-esc="doc.reclamant_id.reclamant_lname or 'Non specifie'"/></td>
                        </tr>
                        <tr>
                            <td><strong>Email :</strong></td>
                            <td><t t-esc="doc.reclamant_id.reclamant_email or 'Non specifie'"/></td>
                        </tr>
                        <tr>
                            <td><strong>Telephone :</strong></td>
                            <td><t t-esc="doc.reclamant_id.reclamant_phone or 'Non specifie'"/></td>
                        </tr>
                    </t>
                    <t t-elif="doc.reclamant_id.type == 'enterprise'">
                        <tr>
                            <td><strong>Nom de l'Entreprise :</strong></td>
                            <td><t t-esc="doc.reclamant_id.company_name or 'Non specifie'"/></td>
                        </tr>
                        <tr>
                            <td><strong>Email :</strong></td>
                            <td><t t-esc="doc.reclamant_id.company_email or 'Non specifie'"/></td>
                        </tr>
                        <tr>
                            <td><strong>Telephone :</strong></td>
                            <td><t t-esc="doc.reclamant_id.company_phone or 'Non specifie'"/></td>
                        </tr>
                        <tr>
                            <td><strong>Secteur d'Activite :</strong></td>
                            <td><t t-esc="doc.reclamant_id.company_sector or 'Non specifie'"/></td>
                        </tr>
                    </t>
                </table>
            </t>
            <t t-else="">
                <p><strong>Reclamant :</strong> Non specifie</p>
            </t>

            <!-- Informations de l'Agent Assigné -->
            <h4 style="color: #0056b3; margin-top: 20px;">Informations de l'Agent Assigne</h4>
            <t t-if="doc.assigned_agent">
                <table style="width: 100%;">
                    <tr>
                        <td style="width: 30%;"><strong>Nom :</strong></td>
                        <td><t t-esc="doc.assigned_agent.name or 'Non specifie'"/></td>
                    </tr>
                    <tr>
                        <td><strong>Rôle :</strong></td>
                        <td><t t-esc="dict(doc.assigned_agent._fields['role'].selection).get(doc.assigned_agent.role, 'Non specifie')"/></td>
                    </tr>
                    <tr>
                        <td><strong>Departement :</strong></td>
                        <td><t t-esc="dict(doc.assigned_agent._fields['department'].selection).get(doc.assigned_agent.department, 'Non specifie')"/></td>
                    </tr>
                </table>
            </t>
            <t t-else="">
                <p><strong>Agent Assigne :</strong> Non assigne</p>
            </t>

            <!-- Ligne de séparation entre les réclamations -->
            <hr style="border: 1px solid #ccc; margin-top: 20px; margin-bottom: 20px;"/>
        </t>
    </t>
</template>

    <!-- Définition du rapport pour le modèle Decision -->
    <record id="report_decision" model="ir.actions.report">
        <field name="name">Rapport de Décision</field>
        <field name="model">reclamationpgi.decision</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">reclamationpgi.report_decision_view</field>
        <field name="binding_model_id" ref="model_reclamationpgi_decision"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Template du rapport pour le modèle Decision -->
    <template id="report_decision_view">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: 'Roboto', Arial, sans-serif; padding: 20px;">
                    <!-- En-tête -->
                    <div class="header" style="text-align: center; margin-bottom: 30px;">
                        <h1 style="color: #0056b3; font-size: 24px; margin-bottom: 10px;">Rapport de Décision</h1>
                        <p style="font-size: 14px; color: #888;">Objet : <t t-esc="doc.name"/></p>
                        <p style="font-size: 14px; color: #888;">Signature : <t t-esc="doc.signature"/></p>
                    </div>

                    <!-- Détails de la décision -->
                    <div class="section" style="margin-bottom: 30px;">
                        <h3 style="border-bottom: 2px solid #0056b3; color: #0056b3; font-size: 18px; padding-bottom: 5px;">Détails de la Décision</h3>
                        <p><strong>Décision :</strong></p>
                        <p><t t-esc="doc.decision"/></p>
                        <p><strong>Statut :</strong> <t t-esc="dict(doc._fields['statut'].selection).get(doc.statut, 'Non spécifié')"/></p>
                        <p><strong>Communiqué :</strong> <t t-esc="'Oui' if doc.is_communicated else 'Non'"/></p>
                    </div>

                    <!-- Membres de la commission -->
                    <div class="section" style="margin-bottom: 30px;">
                        <h3 style="border-bottom: 2px solid #0056b3; color: #0056b3; font-size: 18px; padding-bottom: 5px;">Membres de la Commission</h3>
                        <ul>
                            <t t-foreach="doc.membres_commission" t-as="member">
                                <li><t t-esc="member.name"/></li>
                            </t>
                        </ul>
                    </div>

                    <!-- Intervention associée -->
                    <div class="section" style="margin-bottom: 30px;">
                        <h3 style="border-bottom: 2px solid #0056b3; color: #0056b3; font-size: 18px; padding-bottom: 5px;">Intervention Associée</h3>
                        <p><strong>Intervention :</strong> <t t-esc="doc.intervention_id.name or 'Non spécifiée'"/></p>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>